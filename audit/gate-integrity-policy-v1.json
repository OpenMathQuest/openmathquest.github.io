{
  "policyId": "math-quest-gate-integrity",
  "version": "1.3.4",
  "schemaVersion": 1,
  "status": "ACTIVE",
  "primaryConsumer": "AI_AGENT",
  "authority": "THIS_FILE",
  "licence": {
    "spdx": "MIT",
    "scope": "Original Math Quest gate-integrity policy and gate-family registry.",
    "originalWork": true
  },
  "orderingContract": [
    { "jsonPointer": "/rules", "policy": "LEXICOGRAPHIC_BY_ID" },
    { "jsonPointer": "/gateFamilies", "policy": "LEXICOGRAPHIC_BY_ID" },
    { "jsonPointer": "/gateFamilies/*/negativeControl", "policy": "CLOSED_EXECUTABLE_BINDING" },
    { "jsonPointer": "/gateFamilies/*/implementationPaths", "policy": "LEXICOGRAPHIC" },
    { "jsonPointer": "/gateFamilies/*/validatorPaths", "policy": "LEXICOGRAPHIC" },
    { "jsonPointer": "/acceptanceCriteria", "policy": "LEXICOGRAPHIC_BY_ID" }
  ],
  "statusSemantics": {
    "PASS": "RAN_COMPLETE_AND_ORACLE_ASSERTED_TRUE",
    "FAIL": "RAN_COMPLETE_AND_ORACLE_ASSERTED_FALSE",
    "BLOCKED": "PRECONDITION_AUTHORITY_OR_REQUIRED_EVIDENCE_BLOCKED_FAIL_CLOSED",
    "ERROR": "GATE_EXECUTION_FAILED_FAIL_CLOSED",
    "TIMEOUT": "GATE_EXCEEDED_MEASURED_BOUND_FAIL_CLOSED",
    "CANCELLED": "GATE_CANCELLED_FAIL_CLOSED",
    "SKIPPED": "REQUIRED_EXECUTION_WAS_SKIPPED_FAIL_CLOSED",
    "MISSING_ARTIFACT": "REQUIRED_EVIDENCE_ABSENT_FAIL_CLOSED",
    "NOT_RUN": "REQUIRED_EXECUTION_DID_NOT_START_FAIL_CLOSED",
    "NOT_REQUIRED_BY_CADENCE": "PREDECLARED_CADENCE_EXCLUSION_NOT_A_PASS",
    "DEFERRED": "EXPLICIT_OWNER_DECISION_WITH_RESIDUAL_RISK_NOT_A_PASS",
    "OPTIONAL_NOT_RUN": "PREDECLARED_OPTION_NOT_SELECTED_NOT_A_PASS",
    "OWNER_SKIPPED": "EXPLICIT_RELEASE_SCOPED_OWNER_DECISION_NOT_A_PASS",
    "WAIVED": "EXPLICIT_EMERGENCY_RELEASE_SCOPED_OWNER_DECISION_NOT_A_PASS"
  },
  "rules": [
    {
      "id": "GI-R01",
      "directive": "REPAIR_PRODUCT_DEFECTS_WITHOUT_WEAKENING_THE_ORACLE",
      "rationale": "The game is the target; a green indicator is only evidence about it.",
      "falsePassPrevented": "SPECIFICATION_GAMING"
    },
    {
      "id": "GI-R02",
      "directive": "EVERY_GATE_FAMILY_REQUIRES_AN_EXECUTED_NEGATIVE_CONTROL",
      "rationale": "A passing path carries no information unless a representative prohibited state is shown to fail.",
      "falsePassPrevented": "VACUOUS_GATE"
    },
    {
      "id": "GI-R03",
      "directive": "REQUIRED_ERROR_TIMEOUT_CANCEL_SKIP_MISSING_ARTIFACT_AND_NOT_RUN_STATES_FAIL_CLOSED",
      "rationale": "Missing execution or evidence cannot establish the claimed property.",
      "falsePassPrevented": "ABSENCE_AS_SUCCESS"
    },
    {
      "id": "GI-R04",
      "directive": "PREDECLARED_NOT_REQUIRED_DEFERRED_AND_OPTIONAL_STATES_REMAIN_NON_PASSING_AND_VISIBLE",
      "rationale": "A legitimate cadence or owner decision must not be misreported as successful evidence.",
      "falsePassPrevented": "NON_APPLICABILITY_AS_SUCCESS"
    },
    {
      "id": "GI-R05",
      "directive": "DETECTOR_REPAIR_REQUIRES_PROVEN_DETECTOR_DEFECT_AND_EQUAL_OR_STRONGER_EFFECT_SENSITIVE_PROTECTION",
      "rationale": "A detector can be wrong, but repairing it must not become a route around a real product failure.",
      "falsePassPrevented": "ORACLE_DEGRADATION_DISGUISED_AS_MAINTENANCE"
    },
    {
      "id": "GI-R06",
      "directive": "RERUNS_MAY_DIAGNOSE_OR_VERIFY_A_CHANGE_BUT_MUST_PRESERVE_THE_FIRST_RESULT",
      "rationale": "A later green result cannot erase nondeterminism or the failure that motivated a correction.",
      "falsePassPrevented": "RETRY_TO_GREEN"
    },
    {
      "id": "GI-R07",
      "directive": "METRIC_FLOORS_ARE_VERSIONED_WITH_EXACT_NUMERATOR_DENOMINATOR_AND_MEASUREMENT_SEMANTICS",
      "rationale": "An observed percentage is not automatically a permanent specification and denominator drift must remain visible.",
      "falsePassPrevented": "METRIC_BASELINE_AMBIGUITY"
    },
    {
      "id": "GI-R08",
      "directive": "ONLY_WEAKENING_SUPPRESSION_PRODUCT_CONTRACT_CHANGE_OR_MATERIAL_NEW_DECISION_REQUIRES_OWNER_SELECTION",
      "rationale": "Authorized root-cause repairs and stronger checks should proceed without repeated approval loops.",
      "falsePassPrevented": "APPROVAL_FATIGUE_AND_UNBOUNDED_BLOCKAGE"
    },
    {
      "id": "GI-R09",
      "directive": "EVIDENCE_DIGESTS_MUST_BIND_VALIDATED_CANONICAL_BYTES_OR_EXPLICITLY_LABEL_A_STRUCTURED_ASSERTION",
      "rationale": "A syntactically valid digest is not proof that any evidence exists or was inspected.",
      "falsePassPrevented": "UNBOUND_EVIDENCE_DIGEST"
    },
    {
      "id": "GI-R10",
      "directive": "REPORT_INVENTORY_PASS_FAIL_AND_ACCEPTED_NON_PASS_COUNTS_SEPARATELY",
      "rationale": "Record completeness and successful verification are different claims.",
      "falsePassPrevented": "COUNTED_AS_PASSED"
    },
    {
      "id": "GI-R11",
      "directive": "TIMEOUT_CHANGES_REQUIRE_MEASURED_JUSTIFICATION_AND_MUST_NOT_CONCEAL_NONTERMINATION_OR_REGRESSION",
      "rationale": "Legitimate workload growth can change duration while an arbitrary increase can hide a broken loop.",
      "falsePassPrevented": "TIMEOUT_AS_SUPPRESSION"
    },
    {
      "id": "GI-R12",
      "directive": "UNRESOLVED_MATERIAL_FAILURES_USE_THE_EXISTING_AUTHORITATIVE_RECORD_INSTEAD_OF_AUTOMATIC_NEW_ISSUES",
      "rationale": "Durable evidence matters; duplicate paperwork does not improve the product or the detector.",
      "falsePassPrevented": "STATUS_ARTIFACT_SPRAWL"
    }
  ],
  "metricFloors": {
    "engineBranchCoverage": {
      "version": 1,
      "minimumPercent": 88,
      "numerator": "COVERED_NATIVE_V8_BRANCH_RANGES_FOR_EXACT_STAGED_ENGINE_BYTES",
      "denominator": "ALL_NATIVE_V8_BRANCH_RANGES_FOR_EXACT_STAGED_ENGINE_BYTES",
      "changePolicy": "OWNER_APPROVAL_ONLY_WHEN_MEASUREMENT_SEMANTICS_OR_PRODUCT_CONTRACT_CHANGES"
    },
    "representativeMutationFamilies": {
      "version": 1,
      "minimumKilled": 11,
      "denominator": 11,
      "claimBoundary": "CURATED_CRITICAL_ENGINE_FAMILIES_NOT_GLOBAL_MUTATION_SCORE"
    }
  },
  "enforcement": {
    "repository": "OpenMathQuest/openmathquest.github.io",
    "protectedBranch": "main",
    "requiredPullRequestCheck": "development-checks",
    "prohibitedRequiredPullRequestChecks": ["full-audit"],
    "requiredTagPattern": "refs/tags/v*",
    "requiredTagRules": ["DELETION_PROHIBITED", "UPDATE_PROHIBITED"],
    "codeOwnerReview": "NOT_PRIMARY_CONTROL_FOR_SINGLE_OPERATIONAL_ACTOR",
    "protectedPathWeakeningPolicy": "EXPLICIT_OWNER_APPROVAL_REQUIRED",
    "protectedPathStrengtheningPolicy": "AUTHORIZED_WITH_EXECUTED_NEGATIVE_CONTROL",
    "detectorRepairPolicy": "AUTHORIZED_AFTER_PROVEN_FALSE_POSITIVE_OR_FALSE_NEGATIVE_WITH_EQUAL_OR_STRONGER_EFFECT_PROTECTION",
    "remoteConfigurationVerification": "READ_ONLY_GITHUB_PREFLIGHT_AND_FOCUSED_STATIC_WORKFLOW_CONTRACT",
    "remotePreflightCommand": "node audit/verify-github-gate-enforcement.mjs"
  },
  "retryPolicy": {
    "automaticRetries": 0,
    "diagnosticRerun": "ALLOWED_WITH_FIRST_RESULT_RETAINED",
    "postCorrectionRerun": "REQUIRED_AND_LINKED_TO_CORRECTION",
    "unchangedRerunForGreen": "PROHIBITED"
  },
  "executionPolicy": {
    "schemaVersion": 1,
    "laneOrder": ["coverage", "browser", "playwright", "mutation", "generator"],
    "boundedExecutionStartOrder": ["coverage", "generator", "browser", "playwright", "mutation"],
    "laneSchedulingClass": {
      "browser": "BOUNDED",
      "coverage": "EXCLUSIVE",
      "generator": "BOUNDED",
      "mutation": "BOUNDED",
      "playwright": "BOUNDED"
    },
    "local": {
      "mode": "SERIAL_REFERENCE",
      "maximumConcurrentLanes": 1
    },
    "githubHosted": {
      "mode": "BOUNDED_PARALLEL",
      "maximumConcurrentLanes": 2,
      "adoptionStatus": "PENDING_MEASURED_QUALIFICATION",
      "defaultBeforeQualification": "SERIAL_REFERENCE",
      "qualificationWorkflowInput": "execution_qualification",
      "qualificationEvidenceLocation": "RUNNER_TEMP_OUTSIDE_REPOSITORY_CHECKOUT"
    },
    "laneTimeoutMs": {
      "browser": 2400000,
      "coverage": 240000,
      "generator": 360000,
      "mutation": 180000,
      "playwright": 240000
    },
    "nestedProcessFinalizationReserveMs": {
      "coverage": 15000
    },
    "nestedConcurrency": {
      "browserShardMaximum": 2,
      "playwrightWorkers": 1
    },
    "automaticRetries": 0,
    "resultOrdering": "DECLARED_LANE_ORDER",
    "reportWriter": "PARENT_ONLY",
    "identityBinding": "RUN_ID_REVISION_PUBLIC_CANDIDATE_AND_CROSS_LANE_ENGINE_SHA256",
    "equivalenceProjection": "TIMING_FREE_CANONICAL_GATE_EVIDENCE",
    "minimumMeasuredWallTimeReductionPercent": 20
  },
  "outcomeReporting": {
    "requiredFields": [
      "acceptedNonPassCount",
      "failedCount",
      "inventoryActual",
      "inventoryExpected",
      "missingCount",
      "notRunCount",
      "passedCount",
      "runId",
      "skippedCount"
    ],
    "inventoryMatchMayBeCalledPass": false,
    "acceptedNonPassStates": ["DEFERRED", "NOT_REQUIRED_BY_CADENCE", "OPTIONAL_NOT_RUN", "OWNER_SKIPPED", "WAIVED"],
    "statusClasses": {
      "passed": ["PASS"],
      "failed": ["BLOCKED", "CANCELLED", "ERROR", "FAIL", "TIMEOUT"],
      "missing": ["MISSING_ARTIFACT"],
      "notRun": ["NOT_RUN"],
      "skipped": ["SKIPPED"]
    }
  },
