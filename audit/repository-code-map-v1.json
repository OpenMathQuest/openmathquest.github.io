    "scope": "Original Math Quest file ownership, dependency, and tracked-artifact map.",
    "originalWork": true
  },
  "aiReaderContract": {
    "contractId": "math-quest-ai-first-drift-control",
    "version": 1,
    "primaryConsumer": "AI_AGENT",
    "authority": {
      "path": "AGENTS.md",
      "startMarker": "<!-- AI-FIRST-DRIFT-CONTROL-START -->",
      "endMarker": "<!-- AI-FIRST-DRIFT-CONTROL-END -->",
      "sha256": "6d8f0018125ed2d5a104e0e0c6aeecb94f22f0bb14069138aea1eacb3c0dc0f9"
    },
    "canonicalRecordFormat": "CLOSED_JSON",
    "schemaClosure": "ADDITIONAL_PROPERTIES_FALSE",
    "identifierPolicy": "STABLE_NAMESPACED_IDENTIFIERS",
    "relationshipPolicy": "EXPLICIT_TYPED_EDGES",
    "orderingPolicy": "DECLARED_AND_VALIDATED",
    "prosePolicy": "ANNOTATION_ONLY_NON_NORMATIVE",
    "humanViewPolicy": "GENERATED_NON_AUTHORITATIVE_ONLY",
    "commandOutputPolicy": "MACHINE_READABLE_BY_DEFAULT",
    "ambiguityPolicy": "FAIL_CLOSED",
    "governedSystems": [
      "OWNERS",
      "CODE_MAP",
      "FEATURE_MAP",
      "TUTORIAL_MANIFEST",
      "BLAST_RADIUS",
      "GATES"
    ]
  },
  "orderingContract": [
    {
      "jsonPointer": "/coverageRules",
      "policy": "DECLARED_FIRST_MATCH_PRECEDENCE"
    },
    {
      "jsonPointer": "/factFamilies",
      "policy": "LEXICOGRAPHIC_BY_ID"
    },
    {
      "jsonPointer": "/factFamilies/*/owns",
      "policy": "LEXICOGRAPHIC"
    },
    {
      "jsonPointer": "/factFamilies/*/projections",
      "policy": "LEXICOGRAPHIC_BY_PATH"
    },
    {
      "jsonPointer": "/factFamilies/*/validators",
      "policy": "LEXICOGRAPHIC"
    },
    {
      "jsonPointer": "/artifactRelations",
      "policy": "LEXICOGRAPHIC_BY_ID"
    },
    {
      "jsonPointer": "/dataArtifactPatterns",
      "policy": "LEXICOGRAPHIC"
    },
    {
      "jsonPointer": "/tombstones",
      "policy": "LEXICOGRAPHIC_BY_PATH"
    }
  ],
  "copyPolicySemantics": {
    "REFERENCES_ONLY": "NON_OWNER_MAY_STORE_POINTERS_NOT_OWNED_VALUES",
    "DECLARED_PROJECTIONS_ONLY": "ONLY_DECLARED_PROJECTIONS_MAY_COPY_OWNED_VALUES",
    "SECTION_MIRROR": "DECLARED_PROJECTION_MUST_EXACTLY_MIRROR_MARKED_OWNER_SECTION"
  },
  "copyDiscoverySemantics": {
    "NONE": "NO_COMPLETE_REPOSITORY_LITERAL_SCAN_IS_CLAIMED",
    "OWNER_UTF8_TRIMMED_LITERAL_IN_TRACKED_TEXT": "EVERY_TRACKED_TEXT_FILE_CONTAINING_THE_EXACT_TRIMMED_OWNER_BYTES_MUST_BE_A_DECLARED_PROJECTION"
  },
  "projectionRelationshipSemantics": {
    "GENERATED": "OWNER_OR_DECLARED_GENERATOR_WRITES_PROJECTION",
    "EXACT_MIRROR": "PROJECTION_BYTES_OR_MARKED_SECTION_EQUAL_OWNER_AUTHORITY",
    "RUNTIME_EMBED": "PROJECTION_EMBEDS_OWNER_FACTS_IN_RUNTIME_BYTES",
    "DOCUMENTED_REFERENCE": "PROJECTION_STORES_POINTER_OR_DIGEST_NOT_AUTHORITY",
    "STATE_DEPENDENT_DOCUMENTED_REFERENCE": "PROJECTION_STORES_OWNER_FACT_ONLY_WHEN_ITS_EVIDENCE_STATE_REQUIRES_THAT_FACT",
    "LOCKFILE": "PROJECTION_LOCKS_OWNER_DECLARED_DEPENDENCY_GRAPH",
    "OPERATIONAL_CONFIG": "PROJECTION_CONFIGURES_BUILD_LAUNCH_AUDIT_OR_DEPLOYMENT_WITH_OWNER_FACT",
    "VALIDATION_EXPECTATION": "PROJECTION_ASSERTS_OWNER_FACT_IN_VALIDATION_OR_TEST_BYTES",
    "GENERATED_METADATA": "GENERATED_PROJECTION_STORES_OWNER_FACT_WITH_DERIVED_METADATA"
  },
  "relationKindSemantics": {
    "GENERATES": "SOURCE_WRITES_TARGET",
    "EMBEDS": "SOURCE_WRITES_EMBEDDED_REPRESENTATION_IN_TARGET",
    "CONSUMES": "TARGET_READS_SOURCE",
    "VALIDATES": "TARGET_USES_SOURCE_AS_VALIDATION_AUTHORITY",
    "PUBLISHES": "SOURCE_PUBLISHES_TARGET",
    "DOCUMENTS": "TARGET_DOCUMENTS_SOURCE",
    "TESTS": "TARGET_TESTS_SOURCE"
  },
  "coverageRules": [
    {
      "id": "root-governance",
      "pattern": "^(?:\\.gitattributes|\\.gitignore|AGENTS\\.md|CHANGELOG\\.md|CONTRIBUTING\\.md|LICENSE|OPEN_SOURCE_POLICY\\.md|PRIVACY\\.md|PUBLICATION_CLEARANCE\\.md|README\\.md|SECURITY\\.md|THIRD_PARTY_NOTICES\\.md|VERSION)$",
      "role": "governance",
      "releaseImpact": "CERTIFICATION"
    },
    {
      "id": "root-runtime",
      "pattern": "^(?:index\\.html|sw\\.js|manifest\\.webmanifest|release-shell-v1\\.json|audit\\.html)$",
      "role": "runtime",
      "releaseImpact": "PUBLIC_BYTES"
    },
    {
      "id": "root-launchers",
      "pattern": "^(?:Math Quest\\.bat|audit\\.bat|Serve-MathQuest\\.ps1)$",
      "role": "launcher",
      "releaseImpact": "CERTIFICATION"
    },
    {
      "id": "root-toolchain",
      "pattern": "^(?:package(?:-lock)?\\.json|playwright(?:\\.deep-ux)?\\.config\\.mjs)$",
      "role": "toolchain",
      "releaseImpact": "DEVELOPMENT_ONLY"
    },
    {
      "id": "github-workflows",
      "pattern": "^\\.github/",
      "role": "governance",
      "releaseImpact": "CERTIFICATION"
    },
    {
      "id": "runtime-assets",
      "pattern": "^assets/",
      "role": "asset",
      "releaseImpact": "PUBLIC_BYTES"
    },
    {
      "id": "audit-root",
      "pattern": "^audit/[^/]+$",
      "role": "audit",
      "releaseImpact": "CERTIFICATION"
    },
    {
      "id": "audit-fixtures",
      "pattern": "^audit/fixtures/",
      "role": "test",
      "releaseImpact": "DEVELOPMENT_ONLY"
    },
    {
      "id": "audit-library",
      "pattern": "^audit/lib/",
      "role": "audit",
      "releaseImpact": "CERTIFICATION"
    },
    {
      "id": "audit-playwright",
