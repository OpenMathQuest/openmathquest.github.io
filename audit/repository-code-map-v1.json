      "role": "curriculum",
      "releaseImpact": "PUBLIC_BYTES"
    },
    {
      "id": "docs-root",
      "pattern": "^docs/[^/]+$",
      "role": "documentation",
      "releaseImpact": "DOCUMENTATION_ONLY"
    },
    {
      "id": "docs-development",
