          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "dependencyOverrides": {
          "type": "array",
          "prefixItems": [{
            "type": "object",
            "additionalProperties": false,
            "required": ["requester", "dependency", "declaredRange", "version", "licence", "resolved", "integrity", "reason"],
            "properties": {
              "requester": { "const": "bundlewatch" },
              "dependency": { "const": "axios" },
              "declaredRange": { "const": "^0.31.1" },
              "version": { "const": "1.20.0" },
