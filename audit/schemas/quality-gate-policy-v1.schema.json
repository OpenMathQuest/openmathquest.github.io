              "reason": { "type": "string", "minLength": 120 }
            }
          }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "directDependencies": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependency" }
        },
        "qualityToolComponents": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "packageName", "sourceUrl", "sourceCommit", "licenceEvidence", "scope"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9@.-]+$" },
              "kind": { "type": "string", "pattern": "^ci-only-[a-z0-9-]+$" },
              "packageName": { "type": "string", "minLength": 1 },
