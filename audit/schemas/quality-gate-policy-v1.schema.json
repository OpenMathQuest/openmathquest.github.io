{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmathquest.github.io/schemas/quality-gate-policy-v1.schema.json",
  "title": "Math Quest refactor quality-gate policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyId", "version", "schemaVersion", "status", "authority", "baselineCommit", "approvedTutorialMetadataTransition", "runtime", "sliceLifecycle", "candidateBinding", "aiChangeLoop", "qualityToolComponents", "supplyChain", "analysisRatchets", "sourceBudgets", "performanceBudgets", "performanceEvidence", "finishLine"],
  "properties": {
    "policyId": { "const": "math-quest-refactor-quality-gates" },
    "version": { "const": "1.3.0" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "ACTIVE" },
    "authority": { "const": "docs/development/post-beta-backlog.md#agent-refactor-code-tests-and-quality-gates" },
    "baselineCommit": { "const": "2078625b407d5189f579e94e716c86dce86ae90f" },
    "approvedTutorialMetadataTransition": {
      "const": {
        "contractId": "ART_DEC_013_TUTORIAL_METADATA_V1",
        "baselineCommit": "2078625b407d5189f579e94e716c86dce86ae90f",
        "decisionRegisterPath": "audit/art-design-decision-register-v1.json",
        "decisionId": "ART-DEC-013",
        "baselineArtDesignSha256": "f0092420a3cfbe9564f16161523cf62b34680f0144d0a1f8ee6dc7eaf15ec70b",
        "candidateArtDesignSha256": "57f3ba9df84ffe9aa89297b4cc85fa8df97f4f198ff233a8ceddbe6772d32c83",
        "baselineTutorialSha256": "42993421ce2020d0a2cba0405cf34462d55053f804a7e33620330f52d07b50e8",
        "candidateTutorialSha256": "9f24b5d99d984e58aff0a4dc97307bd8305aba2c63179631ed3681974a464874",
        "manifestChangedPointer": "/artDesignBinding/sha256",
        "planChangedPointer": "/manifestSha256"
      }
    },
    "runtime": {
      "const": {
        "nodeVersion": "24.14.0",
        "installCommand": "npm.cmd ci --ignore-scripts --omit=optional --no-audit --no-fund"
      }
    },
    "sliceLifecycle": {
      "const": {
        "order": ["FOCUSED_DEVELOPMENT", "STAGE_COMPLETE_SLICE", "INDEPENDENT_REVIEW_IF_REQUIRED", "CORRECT_AND_REVERIFY", "FREEZE_EXACT_STAGED_TREE", "FULL_NINE_STAGE_LOOP", "ADVANCE"],
        "focusedSelectionAuthority": "tools/blast-radius-lookup.mjs",
        "unknownEffectPolicy": "BROAD_DEVELOPMENT_SUITE",
        "fullLoopCallerEntryCondition": "CALLER_MUST_SUPPLY_A_REVIEW_CLEAR_COMPLETE_SLICE_WITH_ZERO_UNSTAGED_TRACKED_OR_NONIGNORED_UNTRACKED_PATHS",
        "fullLoopInvalidation": "ANY_CANDIDATE_CHANGE_REQUIRES_A_NEW_TREE_AND_COMPLETE_LOOP",
        "releaseCertificationBoundary": "SEPARATE_EXACT_FROZEN_RELEASE_CANDIDATE",
        "gateAdmissionPolicy": "DEMONSTRATED_UNCOVERED_ESCAPE_REQUIRES_AN_EFFECT_SENSITIVE_CONTROL"
      }
    },
    "candidateBinding": {
      "const": {
        "contractId": "STAGED_TREE_CANDIDATE_V1",
        "fileHashAlgorithm": "SHA-256",
        "requiredReportFields": ["baselineCommit", "candidateTreeOid", "gateIntegrityPolicySha256", "nodeExecutableSha256", "nodeVersion", "packageLockSha256", "qualityPolicySha256"],
        "preconditions": ["ZERO_UNSTAGED_TRACKED_PATHS", "ZERO_NONIGNORED_UNTRACKED_PATHS"],
        "postconditions": ["UNCHANGED_STAGED_TREE_OID", "ZERO_UNSTAGED_TRACKED_PATHS", "ZERO_NONIGNORED_UNTRACKED_PATHS"],
        "automaticRetryPolicy": "PROHIBITED"
      }
    },
    "aiChangeLoop": {
      "const": {
        "order": [
          "compiler-types",
          "static-architecture",
          "tests",
          "differential-equivalence",
          "property-fuzz",
          "mutation",
          "security-dependencies",
          "complexity-duplication-size",
          "performance-budgets"
        ],
        "passSemantics": "EVERY_STAGE_MUST_RUN_IN_ORDER_AND_REPORT_PASS_BEFORE_THE_CHANGE_OR_SLICE_MAY_ADVANCE",
        "stages": [
          { "id": "compiler-types", "claim": "SOURCE_PARSES_AND_DECLARED_DATA_CONTRACTS_VALIDATE" },
          { "id": "static-architecture", "claim": "MODULE_DIRECTION_WRITER_OWNERSHIP_AND_PRIVACY_BOUNDARIES_HOLD" },
          { "id": "tests", "claim": "UNIT_INTEGRATION_AND_EFFECT_SENSITIVE_BEHAVIOUR_PASS" },
          { "id": "differential-equivalence", "claim": "PRE_REFACTOR_AND_REFACTORED_OBSERVABLE_RESULTS_ARE_EQUIVALENT" },
          { "id": "property-fuzz", "claim": "BOUNDED_SEEDED_GENERATION_FINDS_NO_INVARIANT_OR_INTERACTION_FAILURE" },
          { "id": "mutation", "claim": "CURATED_CRITICAL_MUTANTS_ARE_KILLED_BY_INDEPENDENT_ORACLES" },
          { "id": "security-dependencies", "claim": "SECRETS_STATIC_SECURITY_DEPENDENCY_INTEGRITY_LICENCES_AND_VULNERABILITIES_PASS" },
          { "id": "complexity-duplication-size", "claim": "COMPLEXITY_DUPLICATION_DEAD_CODE_FUNCTION_AND_FILE_RATCHETS_DO_NOT_WORSEN" },
          { "id": "performance-budgets", "claim": "SHIPPED_BYTES_AND_MEASURED_RUNTIME_BUDGETS_DO_NOT_REGRESS" }
        ]
      }
    },
    "qualityToolComponents": { "$ref": "#/$defs/supplyChain/properties/qualityToolComponents" },
    "supplyChain": { "$ref": "#/$defs/supplyChain" },
    "analysisRatchets": { "$ref": "#/$defs/analysisRatchets" },
    "sourceBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineCountContract", "strictMaximumLinesByExtension", "legacyLineRatchets"],
      "properties": {
        "lineCountContract": { "const": "UTF8_TEXT_LINES_WITH_CRLF_OR_LF_AND_NO_SYNTHETIC_TRAILING_EMPTY_LINE" },
        "strictMaximumLinesByExtension": {
          "const": { ".css": 500, ".html": 600, ".js": 600, ".mjs": 600, ".ps1": 500 }
        },
        "legacyLineRatchets": {
          "type": "array",
          "maxItems": 25,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "maximumLines"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)[A-Za-z0-9._/-]+$" },
              "maximumLines": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "performanceBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stylesheetMaximumBytes", "javascriptMaximumBytes", "compiledAssetMaximumBytes", "productionPayloadMaximumBytes", "engineScenarioMaximumWallTimeMs", "qualityGateMaximumWallTimeMs"],
      "properties": {
        "stylesheetMaximumBytes": { "type": "integer", "minimum": 1 },
        "javascriptMaximumBytes": { "type": "integer", "minimum": 1 },
        "compiledAssetMaximumBytes": { "type": "integer", "minimum": 1 },
        "productionPayloadMaximumBytes": { "type": "integer", "minimum": 1 },
        "engineScenarioMaximumWallTimeMs": { "type": "integer", "minimum": 1000 },
        "qualityGateMaximumWallTimeMs": { "type": "integer", "minimum": 1000 }
      }
    },
    "performanceEvidence": {
      "const": {
        "applicationMetricsPolicy": "HARD_FAIL_IN_EVERY_ENVIRONMENT",
        "qualityGateWallTimeMetric": "qualityGateWallTimeMs",
        "calibratedEnvironmentVariable": "MQ_CALIBRATED_QUALITY_GATE_RUNTIME",
        "calibratedRequiredValue": "1",
        "calibratedPolicy": "HARD_FAIL_AT_THE_EXISTING_BUDGET",
        "uncalibratedPolicy": "MEASURE_AND_REPORT_AS_UNCALIBRATED_ENVIRONMENT_TELEMETRY",
        "automaticRetryPolicy": "PROHIBITED"
      }
    },
    "finishLine": {
      "const": {
        "requiredCheckpointOrder": ["R0", "R1", "R2", "R3", "R4"],
        "zeroFindingTargets": ["eslintWarnings", "knipUnusedExports", "knipDuplicateExports", "markdownlintFindings", "stylelintFindings", "sourceBudgetFindings", "performanceBudgetFindings"],
        "driftChain": ["Owners", "Code Map", "Feature Map", "Tutorial Manifest", "Art Design", "Blast Radius", "Gates"],
        "releaseCertificationBoundary": "DEVELOPMENT_CHECKS_ONLY_UNTIL_A_SEPARATELY_FROZEN_RELEASE_CANDIDATE",
        "legacyEslintCompletion": "RATCHET_DURING_R2_AND_R3_ZERO_WARNINGS_REQUIRED_AT_R4"
      }
    }
  },
  "$defs": {
