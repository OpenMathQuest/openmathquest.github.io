                "licence": { "const": "MIT" },
                "reason": { "type": "string", "minLength": 80 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "version", "licence", "reason"],
              "properties": {
                "path": { "const": "node_modules/svg-tags" },
                "version": { "const": "1.0.0" },
