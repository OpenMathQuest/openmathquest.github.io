        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "licence": { "type": "string", "minLength": 1 },
        "resolved": { "type": "string", "pattern": "^https://registry\\.npmjs\\.org/" },
        "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+=*$" }
      }
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
