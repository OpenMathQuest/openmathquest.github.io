{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmathquest.github.io/schemas/gate-integrity-policy-v1.schema.json",
  "title": "Math Quest gate-integrity policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyId", "version", "schemaVersion", "status", "primaryConsumer", "authority", "licence", "orderingContract", "statusSemantics", "rules", "metricFloors", "enforcement", "retryPolicy", "executionPolicy", "outcomeReporting", "gateFamilies", "acceptanceCriteria"],
  "properties": {
    "policyId": { "const": "math-quest-gate-integrity" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "ACTIVE" },
    "primaryConsumer": { "const": "AI_AGENT" },
    "authority": { "const": "THIS_FILE" },
    "licence": { "$ref": "#/$defs/licence" },
    "orderingContract": {
      "const": [
        { "jsonPointer": "/rules", "policy": "LEXICOGRAPHIC_BY_ID" },
        { "jsonPointer": "/gateFamilies", "policy": "LEXICOGRAPHIC_BY_ID" },
        { "jsonPointer": "/gateFamilies/*/negativeControl", "policy": "CLOSED_EXECUTABLE_BINDING" },
        { "jsonPointer": "/gateFamilies/*/implementationPaths", "policy": "LEXICOGRAPHIC" },
        { "jsonPointer": "/gateFamilies/*/validatorPaths", "policy": "LEXICOGRAPHIC" },
        { "jsonPointer": "/acceptanceCriteria", "policy": "LEXICOGRAPHIC_BY_ID" }
      ]
    },
    "statusSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "FAIL", "BLOCKED", "ERROR", "TIMEOUT", "CANCELLED", "SKIPPED", "MISSING_ARTIFACT", "NOT_RUN", "NOT_REQUIRED_BY_CADENCE", "DEFERRED", "OPTIONAL_NOT_RUN", "OWNER_SKIPPED", "WAIVED"],
      "properties": {
        "PASS": { "const": "RAN_COMPLETE_AND_ORACLE_ASSERTED_TRUE" },
        "FAIL": { "const": "RAN_COMPLETE_AND_ORACLE_ASSERTED_FALSE" },
        "BLOCKED": { "const": "PRECONDITION_AUTHORITY_OR_REQUIRED_EVIDENCE_BLOCKED_FAIL_CLOSED" },
        "ERROR": { "const": "GATE_EXECUTION_FAILED_FAIL_CLOSED" },
        "TIMEOUT": { "const": "GATE_EXCEEDED_MEASURED_BOUND_FAIL_CLOSED" },
        "CANCELLED": { "const": "GATE_CANCELLED_FAIL_CLOSED" },
        "SKIPPED": { "const": "REQUIRED_EXECUTION_WAS_SKIPPED_FAIL_CLOSED" },
        "MISSING_ARTIFACT": { "const": "REQUIRED_EVIDENCE_ABSENT_FAIL_CLOSED" },
        "NOT_RUN": { "const": "REQUIRED_EXECUTION_DID_NOT_START_FAIL_CLOSED" },
        "NOT_REQUIRED_BY_CADENCE": { "const": "PREDECLARED_CADENCE_EXCLUSION_NOT_A_PASS" },
        "DEFERRED": { "const": "EXPLICIT_OWNER_DECISION_WITH_RESIDUAL_RISK_NOT_A_PASS" },
        "OPTIONAL_NOT_RUN": { "const": "PREDECLARED_OPTION_NOT_SELECTED_NOT_A_PASS" },
        "OWNER_SKIPPED": { "const": "EXPLICIT_RELEASE_SCOPED_OWNER_DECISION_NOT_A_PASS" },
        "WAIVED": { "const": "EXPLICIT_EMERGENCY_RELEASE_SCOPED_OWNER_DECISION_NOT_A_PASS" }
      }
    },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
    "metricFloors": { "$ref": "#/$defs/metricFloors" },
    "enforcement": { "$ref": "#/$defs/enforcement" },
    "retryPolicy": { "$ref": "#/$defs/retryPolicy" },
    "executionPolicy": { "$ref": "#/$defs/executionPolicy" },
    "outcomeReporting": { "$ref": "#/$defs/outcomeReporting" },
    "gateFamilies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gateFamily" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptance" } }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
    "id": { "type": "string", "pattern": "^[A-Z]+-[A-Z0-9-]+$" },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "scope", "originalWork"],
      "properties": { "spdx": { "const": "MIT" }, "scope": { "type": "string", "minLength": 1 }, "originalWork": { "const": true } }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "directive", "rationale", "falsePassPrevented"],
      "properties": {
        "id": { "type": "string", "pattern": "^GI-R(?:0[1-9]|1[0-2])$" },
        "directive": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "rationale": { "type": "string", "minLength": 24 },
        "falsePassPrevented": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
      }
    },
    "metricFloors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineBranchCoverage", "representativeMutationFamilies"],
      "properties": {
        "engineBranchCoverage": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "minimumPercent", "numerator", "denominator", "changePolicy"],
          "properties": { "version": { "const": 1 }, "minimumPercent": { "const": 88 }, "numerator": { "type": "string", "minLength": 1 }, "denominator": { "type": "string", "minLength": 1 }, "changePolicy": { "type": "string", "minLength": 1 } }
        },
        "representativeMutationFamilies": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "minimumKilled", "denominator", "claimBoundary"],
          "properties": { "version": { "const": 1 }, "minimumKilled": { "const": 11 }, "denominator": { "const": 11 }, "claimBoundary": { "const": "CURATED_CRITICAL_ENGINE_FAMILIES_NOT_GLOBAL_MUTATION_SCORE" } }
        }
      }
    },
    "enforcement": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "protectedBranch", "requiredPullRequestCheck", "prohibitedRequiredPullRequestChecks", "requiredTagPattern", "requiredTagRules", "codeOwnerReview", "protectedPathWeakeningPolicy", "protectedPathStrengtheningPolicy", "detectorRepairPolicy", "remoteConfigurationVerification", "remotePreflightCommand"],
      "properties": {
        "repository": { "const": "OpenMathQuest/openmathquest.github.io" },
        "protectedBranch": { "const": "main" },
        "requiredPullRequestCheck": { "const": "development-checks" },
        "prohibitedRequiredPullRequestChecks": { "const": ["full-audit"] },
        "requiredTagPattern": { "const": "refs/tags/v*" },
        "requiredTagRules": { "const": ["DELETION_PROHIBITED", "UPDATE_PROHIBITED"] },
        "codeOwnerReview": { "const": "NOT_PRIMARY_CONTROL_FOR_SINGLE_OPERATIONAL_ACTOR" },
        "protectedPathWeakeningPolicy": { "const": "EXPLICIT_OWNER_APPROVAL_REQUIRED" },
        "protectedPathStrengtheningPolicy": { "const": "AUTHORIZED_WITH_EXECUTED_NEGATIVE_CONTROL" },
        "detectorRepairPolicy": { "const": "AUTHORIZED_AFTER_PROVEN_FALSE_POSITIVE_OR_FALSE_NEGATIVE_WITH_EQUAL_OR_STRONGER_EFFECT_PROTECTION" },
        "remoteConfigurationVerification": { "const": "READ_ONLY_GITHUB_PREFLIGHT_AND_FOCUSED_STATIC_WORKFLOW_CONTRACT" },
        "remotePreflightCommand": { "const": "node audit/verify-github-gate-enforcement.mjs" }
      }
    },
    "retryPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["automaticRetries", "diagnosticRerun", "postCorrectionRerun", "unchangedRerunForGreen"],
      "properties": {
        "automaticRetries": { "const": 0 },
        "diagnosticRerun": { "const": "ALLOWED_WITH_FIRST_RESULT_RETAINED" },
        "postCorrectionRerun": { "const": "REQUIRED_AND_LINKED_TO_CORRECTION" },
        "unchangedRerunForGreen": { "const": "PROHIBITED" }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "laneOrder", "boundedExecutionStartOrder", "laneSchedulingClass", "local", "githubHosted", "focusedPlaywright", "laneTimeoutMs", "nestedProcessFinalizationReserveMs", "nestedProcessTimeoutCleanup", "nestedConcurrency", "automaticRetries", "resultOrdering", "reportWriter", "identityBinding", "equivalenceProjection", "minimumMeasuredWallTimeReductionPercent"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "laneOrder": { "const": ["coverage", "browser", "playwright", "mutation", "generator"] },
        "boundedExecutionStartOrder": { "const": ["coverage", "generator", "browser", "playwright", "mutation"] },
        "laneSchedulingClass": {
          "const": { "browser": "BOUNDED", "coverage": "EXCLUSIVE", "generator": "BOUNDED", "mutation": "BOUNDED", "playwright": "BOUNDED" }
        },
        "local": {
          "const": { "mode": "SERIAL_REFERENCE", "maximumConcurrentLanes": 1 }
        },
        "githubHosted": {
          "const": {
            "mode": "BOUNDED_PARALLEL",
            "maximumConcurrentLanes": 2,
            "adoptionStatus": "DISQUALIFIED_MEASURED_QUALIFICATION",
            "defaultBeforeQualification": "SERIAL_REFERENCE",
            "qualificationWorkflowInput": "execution_qualification",
            "qualificationEvidenceLocation": "RUNNER_TEMP_OUTSIDE_REPOSITORY_CHECKOUT",
            "qualificationAttempts": [
              {
                "workflowRunId": 32557129231,
                "candidateId": "1259a58b55a8954addda13151e0e1df3b2067452:803f72f99a3084f0187e39794a0997e6d38fd84ee3fdd47e2efe76456823d6fc",
                "evidenceArtifactId": 9471938142,
                "serialWallDurationMs": 410960,
                "boundedWallDurationMs": 331017,
                "measuredWallTimeReductionPercent": 19.45,
                "minimumRequiredWallTimeReductionPercent": 20,
                "evidenceEquivalent": false,
                "outcome": "FAIL",
                "issues": [
                  "TIMING_FREE_CANONICAL_GATE_EVIDENCE_DIFFERED",
                  "MEASURED_REDUCTION_BELOW_MINIMUM"
                ]
              },
              {
                "workflowRunId": 32941141949,
                "candidateId": "0f5ed9f7c58cee06e2f89417b7d8fe9cabb5fc80:5cb92d8877279919fd714736d27a0b9d58015ada841e158f0dd158dbc7467f94",
                "evidenceArtifactId": 9597169671,
                "serialWallDurationMs": 518723,
                "boundedWallDurationMs": 430815,
                "measuredWallTimeReductionPercent": 16.95,
                "minimumRequiredWallTimeReductionPercent": 20,
                "evidenceEquivalent": true,
                "outcome": "FAIL",
                "issues": ["MEASURED_REDUCTION_BELOW_MINIMUM"]
              },
              {
                "workflowRunId": 32945325690,
                "candidateId": "bc082b0c2a72de0126128834abf89cea1ba01477:1088b7d2b9a22f2a7d1011e55d0b6c66583a3cfe0aa56c761840db810833cbaa",
                "evidenceArtifactId": 9598351496,
                "serialWallDurationMs": 462745,
                "boundedWallDurationMs": null,
                "measuredWallTimeReductionPercent": null,
                "minimumRequiredWallTimeReductionPercent": 20,
                "evidenceEquivalent": null,
                "outcome": "FAIL",
                "issues": ["SERIAL_REFERENCE_PLAYWRIGHT_TIMEOUT"]
              },
              {
                "workflowRunId": 32948683475,
                "candidateId": "863afd09c21502291f6da7501adcbb7d8e896acb:4a223fab070d951ee4deb3cce3b90d61d853ba7fe7d3fdea982cb91b36ad8423",
                "evidenceArtifactId": 9599935551,
                "serialWallDurationMs": 496489,
                "boundedWallDurationMs": 412932,
                "measuredWallTimeReductionPercent": 16.83,
                "minimumRequiredWallTimeReductionPercent": 20,
                "evidenceEquivalent": true,
                "outcome": "FAIL",
                "issues": ["MEASURED_REDUCTION_BELOW_MINIMUM"]
              }
            ],
            "qualificationResult": {
              "workflowRunId": 32948683475,
              "candidateId": "863afd09c21502291f6da7501adcbb7d8e896acb:4a223fab070d951ee4deb3cce3b90d61d853ba7fe7d3fdea982cb91b36ad8423",
              "evidenceArtifactId": 9599935551,
              "serialWallDurationMs": 496489,
              "boundedWallDurationMs": 412932,
              "measuredWallTimeReductionPercent": 16.83,
              "minimumRequiredWallTimeReductionPercent": 20,
              "evidenceEquivalent": true,
              "outcome": "FAIL",
              "issues": ["MEASURED_REDUCTION_BELOW_MINIMUM"]
            }
          }
        },
        "focusedPlaywright": {
          "const": {
            "testTimeoutMs": 60000,
            "expectTimeoutMs": 7500,
            "timeoutChangeEvidence": {
              "workflowRunId": 32945325690,
              "evidenceArtifactId": 9598351496,
              "caseKey": "edge-desktop:PW-F-01",
              "failedDurationMs": 35141,
              "priorPassingWorkflowRunId": 32941141949,
              "priorPassingDurationMs": 3390,
              "sameHostedBrowserRunnerTuple": true,
              "classification": "HOSTED_COLD_START_ACTIONABILITY_TIMEOUT",
              "preservedControls": ["NATIVE_ACTIONABILITY", "NO_FORCED_INTERACTION", "ZERO_RETRIES"]
            }
          }
        },
        "laneTimeoutMs": {
          "const": { "browser": 2400000, "coverage": 240000, "generator": 360000, "mutation": 180000, "playwright": 240000 }
        },
        "nestedProcessFinalizationReserveMs": {
          "const": { "coverage": 15000 }
        },
        "nestedProcessTimeoutCleanup": {
          "const": { "coverage": "FULL_TREE_TERMINATION_VERIFIED_BEFORE_SUBSEQUENT_LANES" }
        },
        "nestedConcurrency": {
          "const": { "browserShardMaximum": 2, "browserShardMaximumWhenTopLevelParallel": 1, "playwrightWorkers": 1 }
        },
        "automaticRetries": { "const": 0 },
        "resultOrdering": { "const": "DECLARED_LANE_ORDER" },
        "reportWriter": { "const": "PARENT_ONLY" },
        "identityBinding": { "const": "RUN_ID_REVISION_PUBLIC_CANDIDATE_AND_CROSS_LANE_ENGINE_SHA256" },
        "equivalenceProjection": { "const": "TIMING_FREE_CANONICAL_GATE_EVIDENCE" },
        "minimumMeasuredWallTimeReductionPercent": { "const": 20 }
      }
    },
    "outcomeReporting": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredFields", "inventoryMatchMayBeCalledPass", "acceptedNonPassStates", "statusClasses"],
      "properties": {
        "requiredFields": { "const": ["acceptedNonPassCount", "failedCount", "inventoryActual", "inventoryExpected", "missingCount", "notRunCount", "passedCount", "runId", "skippedCount"] },
        "inventoryMatchMayBeCalledPass": { "const": false },
        "acceptedNonPassStates": { "const": ["DEFERRED", "NOT_REQUIRED_BY_CADENCE", "OPTIONAL_NOT_RUN", "OWNER_SKIPPED", "WAIVED"] },
        "statusClasses": {
          "const": {
            "passed": ["PASS"],
            "failed": ["BLOCKED", "CANCELLED", "ERROR", "FAIL", "TIMEOUT"],
            "missing": ["MISSING_ARTIFACT"],
            "notRun": ["NOT_RUN"],
            "skipped": ["SKIPPED"]
          }
        }
      }
    },
    "gateFamily": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim", "proofClass", "independenceBoundary", "nonRunPolicy", "negativeControl", "implementationPaths", "validatorPaths"],
      "properties": {
        "id": { "type": "string", "pattern": "^gate\\.[a-z][a-z0-9-]+$" },
        "claim": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "proofClass": { "enum": ["BOUND_EVIDENCE", "BOUND_EVIDENCE_AND_EFFECT_SENSITIVE_BROWSER", "EFFECT_SENSITIVE_BROWSER", "EFFECT_SENSITIVE_HOSTED_BROWSER", "EFFECT_SENSITIVE_UNIT_AND_INTEGRATION", "EXHAUSTIVE_INTERNAL_CONSISTENCY", "EXTERNAL_ENFORCEMENT", "INDEPENDENT_SEMANTIC_ORACLE", "INSTRUMENTED_MEASUREMENT", "REPRESENTATIVE_MUTATION", "STATIC_AND_BYTE_IDENTITY"] },
        "independenceBoundary": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "nonRunPolicy": { "enum": ["FAIL", "CADENCE_ENUM"] },
        "negativeControl": { "$ref": "#/$defs/negativeControl" },
        "implementationPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "validatorPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
      }
    },
    "negativeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "executionMode", "executionPath"],
      "properties": {
        "id": { "type": "string", "pattern": "^NC-[A-Z0-9_-]+$" },
        "executionMode": { "enum": ["NODE_TEST", "SELF_TEST"] },
        "executionPath": { "$ref": "#/$defs/path" },
        "testName": { "type": "string", "pattern": "^\\[NC-[A-Z0-9_-]+\\] .+$" },
        "passEvidence": {
          "type": "string",
          "pattern": "^(?:REPORT_FIELD:negativeControls\\.NC-[A-Z0-9_-]+\\.status=PASS|STDOUT:NEGATIVE_CONTROL=NC-[A-Z0-9_-]+:PASS)$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "executionMode": { "const": "NODE_TEST" } }, "required": ["executionMode"] },
          "then": { "properties": { "testName": { "type": "string" } }, "required": ["testName"] }
        },
        {
          "if": { "properties": { "executionMode": { "const": "SELF_TEST" } }, "required": ["executionMode"] },
          "then": { "properties": { "passEvidence": { "type": "string" } }, "required": ["passEvidence"] }
        }
      ]
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "predicate"],
      "properties": { "id": { "type": "string", "pattern": "^GI-A0[1-9]$" }, "predicate": { "type": "string", "pattern": "^[A-Z0-9_]+$" } }
    }
  }
}
