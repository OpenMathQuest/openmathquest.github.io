{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmathquest.github.io/schemas/feature-map-v1.schema.json",
  "title": "Math Quest user-operable feature map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mapId", "version", "schemaVersion", "licence", "aiReaderContractRef", "aiSemantics", "orderingContract", "curriculumBinding", "tutorialBinding", "artDesignBinding", "proofKindCatalog", "proofGateOwners", "invariants", "features"],
  "properties": {
    "mapId": { "const": "math-quest-feature-map" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "schemaVersion": { "const": 1 },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "scope", "originalWork"],
      "properties": {
        "spdx": { "const": "MIT" },
        "scope": { "type": "string", "minLength": 1 },
        "originalWork": { "const": true }
      }
    },
    "aiReaderContractRef": { "$ref": "#/$defs/aiReaderContractRef" },
    "aiSemantics": {
      "const": {
        "featureIdentityKey": "id",
        "mechanicJoinKey": "inputMethod",
        "artDesignJoinKey": "artDesignBinding.path",
        "artDesignBoundary": "ART_DESIGN_MAY_CONSTRAIN_PRESENTATION_NOT_MECHANIC_IDENTITY_OR_BEHAVIOR",
        "invariantIdentityKey": "id",
        "invariantPredicateKey": "predicate",
        "stepActionKey": "action",
        "proofKeyTemplate": "{feature.id}#{proof.kind}@{proof.gate}",
        "actionSequencePolicy": "ARRAY_ORDER_IS_USER_ACTION_ORDER",
        "narrativeFieldPolicy": "ANNOTATION_ONLY_NON_NORMATIVE",
        "narrativeFields": ["entry", "goal", "invariants[].statement", "invariants[].proofBoundary", "steps[].target", "proofs[].expect", "proofs[].observe", "humanReview.questions[]"]
      }
    },
    "orderingContract": {
      "const": [
        { "jsonPointer": "/proofKindCatalog", "policy": "LEXICOGRAPHIC_BY_KIND" },
        { "jsonPointer": "/proofGateOwners", "policy": "LEXICOGRAPHIC_BY_GATE" },
        { "jsonPointer": "/invariants", "policy": "LEXICOGRAPHIC_BY_ID" },
        { "jsonPointer": "/features", "policy": "EXACT_TUTORIAL_METHOD_BINDING_ORDER" },
        { "jsonPointer": "/features/*/steps", "policy": "USER_ACTION_SEQUENCE" },
        { "jsonPointer": "/features/*/proofs", "policy": "DECLARED_PROOF_PRIORITY" }
      ]
    },
    "curriculumBinding": { "$ref": "#/$defs/binding" },
    "tutorialBinding": { "$ref": "#/$defs/binding" },
    "artDesignBinding": { "$ref": "#/$defs/binding" },
    "proofKindCatalog": {
      "const": [
        { "kind": "a11y", "predicate": "ACCESSIBILITY_TREE_AND_TARGET_CONTRACT_HOLDS", "observationClass": "A11Y_TREE" },
        { "kind": "action_discoverability", "predicate": "PRIMARY_ACTION_DISCOVERABLE_AND_ACTIONABLE", "observationClass": "BROWSER_ACTIONABILITY" },
        { "kind": "focus", "predicate": "FOCUS_ORDER_AND_RESTORATION_CONTRACT_HOLDS", "observationClass": "BROWSER_FOCUS" },
        { "kind": "geometry", "predicate": "RENDERED_GEOMETRY_WITHIN_GOVERNED_BOUNDS", "observationClass": "BROWSER_GEOMETRY" },
        { "kind": "grading", "predicate": "INDEPENDENT_GRADING_ORACLE_MATCHES", "observationClass": "INDEPENDENT_ORACLE" },
        { "kind": "human_legibility", "predicate": "TARGETED_HUMAN_COMPREHENSION_REVIEW_PASSES", "observationClass": "HUMAN_REVIEW" },
        { "kind": "no_network", "predicate": "CHILD_PATH_REQUEST_LOG_EMPTY", "observationClass": "NETWORK_LOG" },
        { "kind": "representation_alignment", "predicate": "VISIBLE_REPRESENTATION_MATCHES_TASK_SEMANTICS", "observationClass": "BROWSER_AND_ORACLE" },
        { "kind": "response_space", "predicate": "VALID_CORRECT_AND_INCORRECT_RESPONSES_REACHABLE", "observationClass": "INDEPENDENT_ORACLE" },
        { "kind": "storage", "predicate": "PERSISTED_STATE_TRANSITION_MATCHES_ALLOWLIST", "observationClass": "STORAGE_SNAPSHOT" },
        { "kind": "tutorial", "predicate": "TUTORIAL_V2_RESOLUTION_DISCLOSURE_PHASE_VISUAL_AND_RETURN_CONTRACT_HOLDS", "observationClass": "BROWSER_AND_STORAGE" },
        { "kind": "ui_state", "predicate": "VISIBLE_UI_STATE_MATCHES_DECLARED_STATE", "observationClass": "BROWSER_DOM" }
      ]
    },
    "proofGateOwners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/proofGateOwner" }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "aiReaderContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "version"],
      "properties": {
        "contractId": { "const": "math-quest-ai-first-drift-control" },
        "version": { "const": 1 }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "proofGateOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "path", "selector"],
      "properties": {
        "gate": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
        "selector": { "type": "string", "minLength": 2 }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "predicate", "statement", "proofBoundary"],
      "properties": {
        "id": { "type": "string", "pattern": "^LEG-[0-9]{2}$" },
        "predicate": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "statement": { "type": "string", "minLength": 12 },
        "proofBoundary": { "type": "string", "minLength": 12 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target"],
      "properties": {
        "action": { "enum": ["tap", "type", "drag", "choose", "build", "undo", "confirm", "open_tutorial"] },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expect", "observe", "gate"],
      "properties": {
        "kind": { "enum": ["ui_state", "geometry", "representation_alignment", "action_discoverability", "response_space", "grading", "tutorial", "focus", "a11y", "storage", "no_network", "human_legibility"] },
        "expect": { "type": "string", "minLength": 8 },
        "observe": { "type": "string", "minLength": 8 },
        "gate": { "type": "string", "minLength": 2 }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "inputMethod", "entry", "goal", "steps", "graded", "tutorialFamilyId", "profileDrivenTutorial", "legibilityInvariants", "proofs", "humanReview"],
      "properties": {
        "id": { "type": "string", "pattern": "^child\\.mechanic\\.[a-z0-9-]+$" },
        "actor": { "const": "child" },
        "inputMethod": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "entry": { "const": "ordinary curriculum question or isolated Parent Test question" },
        "goal": { "type": "string", "minLength": 8 },
        "steps": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/step" } },
        "graded": { "const": true },
        "tutorialFamilyId": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, { "type": "null" }] },
        "profileDrivenTutorial": { "type": "boolean" },
        "legibilityInvariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^LEG-[0-9]{2}$" } },
        "proofs": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/proof" } },
        "humanReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "questions"],
          "properties": {
            "required": { "const": true },
            "questions": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } }
          }
        }
      }
    }
  }
}
