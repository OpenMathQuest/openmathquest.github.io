  "config": {
    "default": false,
    "MD001": true,
    "MD003": { "style": "atx" },
    "MD009": true,
    "MD012": true,
    "MD025": true,
    "MD031": true,
    "MD040": true,
    "MD046": { "style": "fenced" },
    "MD047": true
  }
}
